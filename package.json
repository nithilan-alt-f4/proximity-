{
  "name": "proximity-plus",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "A minimal music player with automatic lyrics and auto-tagging â€” Proximity+",
  "author": "Nithilan",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build && electron .",
    "package": "electron-builder --win --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.nithilan.proximity",
    "productName": "proximity+",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.cjs",
      "dist/**/*",
      "!dist-desktop/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "proximity+"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^22.14.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
